{
  "uid": "jev-triage",
  "title": "Jev triage",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "jev",
    "logs"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lines suppressed (counted, not dropped)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT sum(count) FROM jev.routing_decisions WHERE decision = 'suppress' AND $__timeFilter(window_start)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Escalated clusters",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT count() FROM jev.routing_decisions WHERE decision = 'escalate' AND $__timeFilter(window_start)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fallback answer share",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT countIf(source = 'fallback') / greatest(count(), 1) FROM jev.cluster_judgments WHERE $__timeFilter(judged_at)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Incidents",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT count() FROM jev.incidents WHERE $__timeFilter(start)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Log lines by routing decision",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "sql",
          "format": 0,
          "rawSql": "SELECT $__timeInterval(window_start) AS time, decision, sum(count) AS lines FROM jev.routing_decisions WHERE $__timeFilter(window_start) GROUP BY time, decision ORDER BY time"
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Actionable lines by failure category",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT ifNull(category, 'unknown') AS category, sum(count) AS lines FROM jev.routing_decisions WHERE decision IN ('escalate', 'triage', 'review') AND $__timeFilter(window_start) GROUP BY category ORDER BY lines DESC"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Triage board",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT d.decision, d.service, d.level, sum(d.count) AS lines, any(d.category) AS category, round(avg(d.expected_severity), 1) AS severity, round(max(d.p_actionable), 2) AS p_actionable, any(c.template) AS template, any(d.flags) AS flags FROM jev.routing_decisions d LEFT JOIN jev.log_clusters c ON c.template_id = d.template_id AND c.run_id = d.run_id WHERE d.decision != 'suppress' AND $__timeFilter(d.window_start) GROUP BY d.decision, d.service, d.level, d.template_id ORDER BY max(d.priority) DESC LIMIT 100"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Incidents",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "sql",
          "format": 1,
          "rawSql": "SELECT start, incident_id, services, lines, linked_changes, top_hypothesis FROM jev.incidents WHERE $__timeFilter(start) ORDER BY priority DESC LIMIT 50"
        }
      ]
    }
  ]
}
